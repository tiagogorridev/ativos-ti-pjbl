{
  "openapi": "3.0.3",
  "info": {
    "title": "BFF — Sistema de Controle de Ativos de Informática",
    "version": "1.0.0",
    "description": "Backend for Frontend: única porta de entrada do frontend. Agrega o microsserviço de Ativos (MongoDB), o de Alocações (Azure SQL) e a Azure Function de cálculo, e repassa o CRUD a cada microsserviço."
  },
  "tags": [
    {
      "name": "Agregação",
      "description": "Respostas montadas a partir de vários serviços"
    },
    {
      "name": "Alocações",
      "description": "Orquestração entre os dois microsserviços, com publicação de eventos"
    },
    {
      "name": "Ativos",
      "description": "Repassado ao microsserviço de Ativos (MongoDB)"
    },
    {
      "name": "Manutenções",
      "description": "Repassado ao microsserviço de Ativos (MongoDB)"
    },
    {
      "name": "Colaboradores",
      "description": "Repassado ao microsserviço de Alocações (Azure SQL)"
    }
  ],
  "paths": {
    "/aggregated-data": {
      "get": {
        "tags": [
          "Agregação"
        ],
        "summary": "Dados agregados dos dois microsserviços e da Azure Function",
        "description": "Consulta o microsserviço de Ativos, o de Alocações e a Function de depreciação e devolve tudo em um único JSON. Se uma fonte falhar, as demais continuam na resposta e o campo 'fontes' indica qual faltou.",
        "responses": {
          "200": {
            "description": "Dados agregados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "tags": [
          "Agregação"
        ],
        "summary": "Indicadores e movimentações recentes para a tela de Dashboard",
        "responses": {
          "200": {
            "description": "Dashboard",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/alocacoes": {
      "get": {
        "tags": [
          "Alocações"
        ],
        "summary": "Lista alocações (repassado ao microsserviço de Alocações)",
        "parameters": [
          {
            "name": "vigentes",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "colaboradorId",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Alocações"
        ],
        "summary": "Aloca um ativo",
        "description": "Confere o ativo no serviço de Ativos, grava a alocação no serviço de Alocações, marca o ativo como 'Em uso' e publica o evento AtivoAlocado no Azure Service Bus.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "numeroPatrimonio",
                  "colaboradorId"
                ],
                "properties": {
                  "numeroPatrimonio": {
                    "type": "string",
                    "example": "PAT-0003"
                  },
                  "colaboradorId": {
                    "type": "integer",
                    "example": 2
                  },
                  "dataRetirada": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Alocação criada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Erro (mesmo formato dos microsserviços)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "campo": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Erro (mesmo formato dos microsserviços)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "campo": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Erro (mesmo formato dos microsserviços)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "campo": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Erro (mesmo formato dos microsserviços)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "campo": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
